{% extends "_layouts/cp" %}

{% set title = "Owl"|t('owl') %}
{% set selectedSubnavItem = 'events' %}

{% block content %}
    <h2>{{ "Calendars"|t('owl') }}</h2>
    {% if calendars|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ "Name"|t('owl') }}</th>
                    <th>{{ "Handle"|t('owl') }}</th>
                    <th>{{ "Tickets"|t('owl') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for calendar in calendars %}
                    <tr>
                        <td>
                            {% if calendar.color %}
                                <span class="status" style="background-color: {{ calendar.color }}"></span>
                            {% endif %}
                            {{ calendar.name }}
                        </td>
                        <td><code>{{ calendar.handle }}</code></td>
                        <td>{{ calendar.hasTickets ? "Yes"|t('owl') : "—" }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="light">{{ "No calendars yet."|t('owl') }}</p>
    {% endif %}

    <h2 style="margin-top: 24px;">{{ "Recent events"|t('owl') }}</h2>
    {% if events|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ "Title"|t('owl') }}</th>
                    <th>{{ "Calendar"|t('owl') }}</th>
                    <th>{{ "Starts"|t('owl') }}</th>
                    <th>{{ "Repeating"|t('owl') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                    <tr>
                        <td>{{ event.title }}</td>
                        <td>{{ event.calendar.name ?? "—" }}</td>
                        <td>{{ event.startDate ? event.startDate|datetime('short') : "—" }}</td>
                        <td>{{ event.repeating ? "Yes"|t('owl') : "—" }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="light">{{ "No events yet."|t('owl') }}</p>
    {% endif %}
{% endblock %}
